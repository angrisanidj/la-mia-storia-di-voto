63", "description": "", "format": "", "hash": "", "id": "f028e321-1d79-4383-9199-47181fde5b2c", "last_modified": null, "license_type": "https://w3id.org/italia/controlled-vocabulary/licences/A11_CCO10", "metadata_modified": "2021-07-14T12:02:23.567063", "mimetype": null, "mimetype_inner": null, "name": "Unnamed resource", "package_id": "efa4e050-80d4-48ca-ac45-1c7319b310fd", "position": 4, "resource_locator_function": "", "resource_locator_protocol": "", "resource_type": null, "size": null, "state": "active", "url": "http://www.provincia.bz.it/protezione-civile/", "url_type": null}], "tags": [{"display_name": "Bolzano", "id": "e1d6d798-a225-4d64-bb79-580396ae9f33", "name": "Bolzano", "state": "active", "vocabulary_id": null}, {"display_name": "Piano di protezione civile comunale", "id": "692baeeb-2233-468a-b519-cf9cb9a99650", "name": "Piano di protezione civile comunale", "state": "active", "vocabulary_id": null}, {"display_name": "Popolazione e societ\u00e0", "id": "35e112e1-14d9-4e85-8ac3-fce591b3ae68", "name": "Popolazione e societ\u00e0", "state": "active", "vocabulary_id": null}, {"display_name": "Servizi di pubblica utilit\u00e0 e servizi amministrativi", "id": "ead0fc74-03d7-437c-bf18-3e6d8185bd82", "name": "Servizi di pubblica utilit\u00e0 e servizi amministrativi", "state": "active", "vocabulary_id": null}], "relationships_as_subject": [], "relationships_as_object": [], "dataset_is_local": true, "holder_name": "Provincia Autonoma di Bolzano - Alto Adige", "holder_identifier": "p_bz"}, {"author": "Consorzio dei Comuni della Provincia di Bolzano", "author_email": "info@gvcc.net", "creator_user_id": "fe09ff29-be35-4934-b01e-c854cad7c43e", "id": "09ddcd89-ebc7-44a3-8054-d0bd945ebc20", "isopen": true, "license_id": "cc-zero", "license_title": "Creative Commons CCZero", "license_url": "http://www.opendefinition.org/licenses/cc-zero", "maintainer": "Consorzio dei Comuni della Provincia di Bolzano", "maintainer_email": "info@gvcc.net", "metadata_created": "2017-06-09T09:53:21.051188", "metadata_modified": "2022-05-11T16:07:15.177428", "name": "streetnames-from-addresspoints", "notes": "La tabella contiene tutti i nomi della strade comunali dell'Alto Adige.\r\nI nomi delle strade sono stati estratti da circa 130.000 singoli indirizzi che vengono continuamente aggiornati da parte del Consorzio dei Comuni della Provincia di Bolzano.\r\n\r\nNOTA 1: questa tabella \u00e8 statica ed viene quindi aggiornata solo su richiesta. Rappresenta quindi la situazione alla data della sua redazione (vedi anche \"data creazione\").\r\n\r\nSpiegazione delle colonne della tabella:\r\n\r\n* ISTAT_CODE: Codice ISTAT nazionale dei comuni\r\n* GEMEINDE_COMUNE_DE: Nome del Comune in tedesco\r\n* GEMEINDE_COMUNE_IT: Nome del Comune in italiano\r\n* GEMEINDE_COMUNE_LD: Nome del Comune in ladino\r\n* CODE_STRASSE_VIA: Codice della Strada (vedi nota 2)\r\n* STRASSE_VIA_DE: Nome della strada in tedesco\r\n* STRASSE_VIA_IT: Nome della strada in italiano\r\n* STRASSE_VIA_LD: Nome della strada in ladino\r\n\r\nNOTA 2: I valori in CODE_STRASSE_VIA sono univoci solo a livello di comune. Nel caso che questo attributo sia vuoto, si tratta solitamente di frazioni di comune.", "num_resources": 2, "num_tags": 7, "organization": {"id": "b3ee8357-eba0-4e4e-b2d3-6e2cc4e94cfd", "name": "consorzio-dei-comuni", "title": "Consorzio dei Comuni della Provincia di Bolzano", "type": "organization", "description": "Il Consoirzio dei Comuni della Provincia di Bolzano presta i seguenti servizi per i Comuni altoatesini:\r\n\r\nCentro elaborazione dati\r\n\r\n* Centro di riferimento per tutte le applicazioni EDP\r\n* Creazione ed assistenza di sisitemi informatici hard e software\r\n* Collegamenti in rete globali per lo scambio dei dati tra enti pubblici\r\n\r\nConsulenza\r\n\r\n* Assistenza per la soluzione di problemi giuridici di carattere comunale\r\n* Informazioni specifiche con circolari e comunicazioni\r\n* Predisposizione di regolamento standard e bozze di delibere uniformi\r\n\r\nDiritto del lavoro ed elaborazione stipendi\r\n\r\n* Elaborazione di stipendi e compensi per gli impiegati nonch\u00e9 di indennit\u00e1 di carica per gli amministratori\r\n* Interlocutore per tutti i quesiti riguardanti il diritto del lavoro ed i contratti collettivi\r\n\r\nScuola amministrativa\r\n\r\n* Centro per la formazione e per l\u00b4aggiornamento degli amministratori e degli impiegati\r\n* Assistenza ai fini del miglioramento delle strutture organizzative e dei procedimenti amministrativi\r\n* Consulenza agli amministratori per l\u00b4attuazione del loro programma politico\r\n\r\nServizio di revisione\r\n\r\n* Gestione dei controlli interni previsti dalla legge\r\n* Revisione su tutto il territorio condotta per tutti i Comuni sulla base di parametri ed indici obiettivamente confrontabili\r\n* Revisione individuale eseguita in tutti i Comuni interessati dopo un relativo accordo", "image_url": "2017-05-26-101052.5455942017-02-14-133423.742354Logo-Gemeindenverband2.jpg", "created": "2017-02-14T14:31:43.035697", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "b3ee8357-eba0-4e4e-b2d3-6e2cc4e94cfd", "private": false, "state": "active", "title": "Rete viaria - Nomi strade comunali estratte dagli indirizzi", "type": "dataset", "url": "", "version": "", "extras": [{"key": "theme", "value": "[\"http://publications.europa.eu/resource/authority/data-theme/TRAN\"]"}, {"key": "identifier", "value": "p_bz:streetnames-from-addresspoints"}, {"key": "alternate_identifier", "value": "[{\"identifier\": \"p_bz:09ddcd89-ebc7-44a3-8054-d0bd945ebc20\", \"agent\": {\"agent_name\": {\"de\": \"\", \"it\": \"\"}, \"agent_identifier\": \"\"}}]"}, {"key": "themes_aggregate", "value": "[{\"subthemes\": [], \"theme\": \"TRAN\"}]"}, {"key": "publisher_name", "value": "S\u00fcdtiroler Gemeindenverband"}, {"key": "publisher_identifier", "value": "ccpbosc"}, {"key": "issued", "value": "09-06-2017"}, {"key": "modified", "value": "03-10-2018"},