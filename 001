		function fillZeroLeft(stringa, dimensione)
		{
			while(stringa.length < dimensione) stringa = "0" + stringa;
			return stringa;
		}
	
		function modifica(form, valore)
		{
			if(valore != "")
			{

					form.action = fillZeroLeft(valore, 6) + '.html';


					form.submit();
			}
		}
		function modificaAff(form, valore)
		{
			form.action = fillZeroLeft(valore, 3) + '.html';
			form.submit();	
		}		
		function modificaFiglia(form, valore)
		{
			form.action = document.modulo.aggpadreId.value + '_' + fillZeroLeft(valore, 3) + '.html';
