			}
		}
		function modificaAff(form, valore)
		{
			form.action = fillZeroLeft(valore, 3) + '.html';
			form.submit();	
		}		
		function modificaFiglia(form, valore)
		{
			form.action = document.modulo.aggpadreId.value + '_' + fillZeroLeft(valore, 3) + '.html';
